      "note": "Directories, links, cloud placeholders and device paths have no defined object bytes."
    },
    {
      "part": "role_actual_context",
      "status": "UNSUPPORTED",
      "note": "context_digest covers the declared context_refs only. What prompt, history or tool output a role actually saw has no observation point in this contract."
